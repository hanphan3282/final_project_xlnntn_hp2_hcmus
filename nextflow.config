manifest {
    name = 'hcmus/facebook-han-ocr'
    author = 'HCMUS NLP project team'
    description = 'End-to-end ground-truth pipeline for Facebook Han-character images'
    version = '1.0.0'
    nextflowVersion = '>=26.04.0'
}

workDir = "${projectDir}/.nextflow-work"

process {
    executor = 'local'
    shell = ['/bin/bash', '-euo', 'pipefail']
    errorStrategy = 'terminate'

    withLabel: network_io {
        cpus = 4
        memory = '4 GB'
    }
    withLabel: cpu_ocr {
        cpus = 8
        memory = '12 GB'
    }
    withLabel: light {
        cpus = 1
        memory = '2 GB'
    }
}

timeline {
    enabled = true
    file = "${projectDir}/reports/timeline.html"
    overwrite = true
}
report {
    enabled = true
    file = "${projectDir}/reports/report.html"
    overwrite = true
}
trace {
    enabled = true
    file = "${projectDir}/reports/trace.tsv"
    overwrite = true
}
dag {
    enabled = true
    file = "${projectDir}/reports/dag.html"
    overwrite = true
}

profiles {
    standard {
        process.executor = 'local'
    }

    pilot {
        params.data_dir = "${projectDir}/data-pilot"
        params.limit = 10
        params.fetch_workers = 4
        params.gemini_workers = 2
        params.paddle_workers = 1
        params.paddle_cpu_threads = 4
        params.llm_workers = 2
        params.reuse_existing = false
    }
}
