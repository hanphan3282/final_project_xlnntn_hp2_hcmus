# Secrets
.env
chrome_profile/
scripts/client_secret.json
scripts/token.json

# Logs
*.log

# ── Data: bỏ qua tất cả, trừ những gì khai báo rõ bên dưới ────────────────
# Thư mục ảnh thô (69 K file, không commit)
data/input/Images/

# Metadata đầu vào cần để tái tạo pipeline
data/input/*
!data/input/.gitkeep
!data/input/link.txt

# Kết quả trung gian và output tổng quát (không commit)
data/processed/
data/intermediate/
data/output/

# ── Ngoại lệ trong data/output: file ground truth cuối ────────────────────
!data/output/
!data/output/DeepSeek_ground_truth/
!data/output/DeepSeek_ground_truth/ground_truth.jsonl
!data/output/DeepSeek_ground_truth/adjudications_valid.jsonl

# ── Ảnh ground truth (copy từ input bằng copy_ground_truth_images.py) ─────
# Không commit ảnh (~1.3 GB); tái tạo bằng: python scripts/copy_ground_truth_images.py
data/ground_truth_images/

# Thư mục mrDuc thô
data/mrDuc_data/*
!data/mrDuc_data/valid.jsonl
data_packages/
*.tar.zst
*.tmp

# Legacy
Ground_truth/
legacy/images/

# Ảnh thô tại root (đã move sang legacy/images/, không track lại)
images/

# Local backups và experiments
data/*_backup_*/
data/experiments/
models/

# Python
__pycache__/
*.pyc
*.egg-info/
.venv/
.pixi/
.nextflow/
.nextflow-work/
.nextflow.log*
reports/

# Pilot chia sẻ: chỉ commit manifest và 10 ảnh input đã chuẩn hóa.
# Output, ground_truth_images và Images.original-* tiếp tục bị ignore.
data-pilot/*
!data-pilot/input/
data-pilot/input/*
!data-pilot/input/valid.jsonl
!data-pilot/input/Images/
data-pilot/input/Images/*
!data-pilot/input/Images/*.jpg

# Jupyter
.ipynb_checkpoints/

# macOS
.DS_Store
